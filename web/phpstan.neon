includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/
    tmpDir: storage/framework/cache/phpstan
    # Read model casts from the casts() method, so enum casts such as
    # User::$role are typed as the enum rather than the column type.
    parseModelCastsMethod: true
